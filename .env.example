# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Previous key during rotation only (step 1-2 of the runbook below).
# Deploy new ENCRYPTION_KEY + old key here, run re-encryption, then remove.
ENCRYPTION_KEY_PREVIOUS=

# Generate with: openssl rand -base64 32 (separate from ENCRYPTION_KEY)
HMAC_KEY=
# Previous HMAC key during HMAC-only rotation (requires -rekey-hmac run).
HMAC_KEY_PREVIOUS=

# Generate with: openssl rand -base64 48 (min 32 chars)
JWT_SECRET=
# Previous JWT secret during rotation; drop after max refresh TTL (30 days).
JWT_SECRET_PREVIOUS=

# Key rotation runbook (zero downtime):
#   1. make key  -> new value into ENCRYPTION_KEY, old value into ENCRYPTION_KEY_PREVIOUS; deploy.
#      Reads serve both keys; writes use the new key.
#   2. make reencrypt-dry  -> verify planned rewrites.
#      make reencrypt       -> rewrite all PII to the new key (idempotent, resumable).
#   3. Remove ENCRYPTION_KEY_PREVIOUS; deploy. Done.
# JWT rotation: set JWT_SECRET_PREVIOUS to the old secret, deploy, remove after 30 days.

# development | staging | production
ENV=development
# true only behind a trusted load balancer (enables X-Forwarded-For)
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=lending_user
DB_PASSWORD=change-me-in-production
DB_NAME=lending_db
# require in production; disable only for local dev
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

PORT=8080
READ_HEADER_TIMEOUT_S=10
