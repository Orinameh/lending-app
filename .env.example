# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Generate with: openssl rand -base64 32 (separate from ENCRYPTION_KEY)
HMAC_KEY=

# Generate with: openssl rand -base64 48 (min 32 chars)
JWT_SECRET=

# development | staging | production
ENV=development
# true only behind a trusted load balancer (enables X-Forwarded-For)
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=lending_user
DB_PASSWORD=change-me-in-production
DB_NAME=lending_db
# require in production; disable only for local dev
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

PORT=8080
READ_HEADER_TIMEOUT_S=10
